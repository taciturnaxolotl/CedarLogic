# Windows Skia args. Build with clang-cl against the runner's LLVM and link the
# static CRT (/MT) to match CedarLogic's CMAKE_MSVC_RUNTIME_LIBRARY =
# MultiThreaded -- a /MD Skia would fail the app link with LNK2038.
#
# target_cpu is x86 to match the shipping 32-bit CedarLogic build; a mismatched
# architecture fails the link with LNK1112. Bump to "x64" here (and in the app)
# when the desktop build moves to 64-bit.
clang_win = "C:\Program Files\LLVM"
target_cpu = "x86"
extra_cflags = ["/MT"]

# libjpeg-turbo (decode + encode) is REQUIRED for the PDF backend: Skia's
# optional("pdf") is gated on `skia_use_libjpeg_turbo_decode &&
# skia_use_libjpeg_turbo_encode` (BUILD.gn ~L1216), and compiles the null stub
# SkDocument_PDF_None.cpp otherwise -- which is why an earlier "codecs off" build
# linked a SkPDF that returned null. Enable it so PDF is real.
#
# Skia's libjpeg-turbo duplicates wxWidgets' bundled libjpeg (LNK2005 on _jpeg_*
# at the app link). That is resolved on the app side, not here: CedarLogic builds
# wxWidgets with wxUSE_LIBJPEG=OFF (see CMakeLists) so Skia's is the only libjpeg.
# webp stays off (core Skia doesn't reference it); PNG stays on (core references
# SkPngDecoder/Encoder unconditionally and Skia's libpng didn't clash with wx's).
skia_use_libjpeg_turbo_decode = true
skia_use_libjpeg_turbo_encode = true
skia_use_libwebp_decode = false
skia_use_libwebp_encode = false
