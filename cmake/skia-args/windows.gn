# Windows Skia args. Build with clang-cl against the runner's LLVM and link the
# static CRT (/MT) to match CedarLogic's CMAKE_MSVC_RUNTIME_LIBRARY =
# MultiThreaded -- a /MD Skia would fail the app link with LNK2038.
#
# target_cpu is x86 to match the shipping 32-bit CedarLogic build; a mismatched
# architecture fails the link with LNK1112. Bump to "x64" here (and in the app)
# when the desktop build moves to 64-bit.
clang_win = "C:\Program Files\LLVM"
target_cpu = "x86"
extra_cflags = ["/MT"]

# Drop the Skia image codecs that duplicate wxWidgets' bundled ones at static
# link. Only libjpeg actually collided (LNK2005 on _jpeg_*); webp is safe to drop
# too since core Skia doesn't reference it. PNG stays enabled: core Skia
# references SkPngDecoder/Encoder unconditionally (DirectWrite color-glyph
# metrics, image serialization), and Skia's libpng did not clash with wx's.
# The real m124 gates are the per-direction *_decode/*_encode args.
skia_use_libjpeg_turbo_decode = false
skia_use_libjpeg_turbo_encode = false
skia_use_libwebp_decode = false
skia_use_libwebp_encode = false
